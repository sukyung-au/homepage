{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/cards/**",
              "components/explorer/**",
              "components/footer/**",
              "components/forms/**",
              "components/navigation/**",
              "components/surfaces/**",
              "ui_kits/explorer/**",
              "ui_kits/website/**",
              "versions/v1/ui_kits/explorer/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Pretendard Variable|Inter))/i]",
        "message": "Font not provided by the design system. Available: Pretendard Variable, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowCTA'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onClick|href|tone|direction|style|key|ref|className|style|children)$/]",
        "message": "<ArrowCTA> doesn't accept that prop. Declared props: children, onClick, href, tone, direction, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowCTA'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:navy|blue|white)$/]",
        "message": "<ArrowCTA> tone must be one of 'navy' | 'blue' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowCTA'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:right|down|up-right)$/]",
        "message": "<ArrowCTA> direction must be one of 'right' | 'down' | 'up-right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|onDark|disabled|href|type|onClick|style|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, onDark, disabled, href, type, onClick, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|dark-utility|pearl|store-hero)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'dark-utility' | 'pearl' | 'store-hero'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DepthRuler'] > JSXAttribute > JSXIdentifier[name!=/^(?:marks|tone|label|style|key|ref|className|style|children)$/]",
        "message": "<DepthRuler> doesn't accept that prop. Declared props: marks, tone, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DepthRuler'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<DepthRuler> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|links|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: title, links."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: id, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|size|onDark|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, size, onDark, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|label|ratio|radius|shadow|tone|fit|style|key|ref|className|style|children)$/]",
        "message": "<MediaFrame> doesn't accept that prop. Declared props: src, alt, label, ratio, radius, shadow, tone, fit, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaFrame'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<MediaFrame> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaFrame'] > JSXAttribute[name.name='fit'] > Literal[value!=/^(?:cover|contain)$/]",
        "message": "<MediaFrame> fit must be one of 'cover' | 'contain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OptionChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|detail|selected|thumb|onClick|style|key|ref|className|style|children)$/]",
        "message": "<OptionChip> doesn't accept that prop. Declared props: label, detail, selected, thumb, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|eyebrow|title|tagline|actions|hero|children|style|key|ref|className|style|children)$/]",
        "message": "<ProductTile> doesn't accept that prop. Declared props: tone, eyebrow, title, tagline, actions, hero, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductTile'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|parchment|dark|dark-2|dark-3|black)$/]",
        "message": "<ProductTile> tone must be one of 'light' | 'parchment' | 'dark' | 'dark-2' | 'dark-3' | 'black'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|label|kicker|title|body|action|style|key|ref|className|style|children)$/]",
        "message": "<QuoteCard> doesn't accept that prop. Declared props: src, label, kicker, title, body, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|style|key|ref|className|style|children)$/]",
        "message": "<SearchInput> doesn't accept that prop. Declared props: value, onChange, placeholder, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeaderLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<HeaderLink> doesn't accept that prop. Declared props: id, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stage'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|num|label|key|ref|className|style|children)$/]",
        "message": "<Stage> doesn't accept that prop. Declared props: id, num, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='StickyBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|cta|onCta|position|style|key|ref|className|style|children)$/]",
        "message": "<StickyBar> doesn't accept that prop. Declared props: label, value, cta, onCta, position, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StickyBar'] > JSXAttribute[name.name='position'] > Literal[value!=/^(?:fixed|sticky|absolute|relative)$/]",
        "message": "<StickyBar> position must be one of 'fixed' | 'sticky' | 'absolute' | 'relative'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SubNavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<SubNavLink> doesn't accept that prop. Declared props: id, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='TechTopic'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|num|title|read|href|key|ref|className|style|children)$/]",
        "message": "<TechTopic> doesn't accept that prop. Declared props: id, num, title, read, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='TechViz'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|seed|fault|mask|resolution|label|style|key|ref|className|style|children)$/]",
        "message": "<TechViz> doesn't accept that prop. Declared props: kind, seed, fault, mask, resolution, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TechViz'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:seismic|strata|reservoir|structure|log|decline)$/]",
        "message": "<TechViz> kind must be one of 'seismic' | 'strata' | 'reservoir' | 'structure' | 'log' | 'decline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|onDark|chevron|underline|onClick|style|children|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: href, onDark, chevron, underline, onClick, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='UtilityCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|imageLabel|ratio|eyebrow|title|meta|link|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<UtilityCard> doesn't accept that prop. Declared props: src, imageLabel, ratio, eyebrow, title, meta, link, href, onClick, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
